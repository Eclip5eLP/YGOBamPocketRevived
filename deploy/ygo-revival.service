# Yugioh BAM Pocket Revived: systemd unit template.
# Replace YOUR_USER, /path/to/YGOBamPocketRevived and ygo.example.com, then:
#   sudo cp deploy/ygo-revival.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now ygo-revival
[Unit]
Description=Yugioh BAM Pocket Revived server
After=network.target

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_USER
WorkingDirectory=/path/to/YGOBamPocketRevived
Environment=PUBLIC_HOST=ygo.example.com
Environment=PYTHONUNBUFFERED=1
# Optional: a file with YGO_LOG_TOKEN=<secret> enables GET /_logs (header X-Log-Token).
EnvironmentFile=-/etc/ygo-revival.env
ExecStart=/bin/bash deploy/run.sh
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
